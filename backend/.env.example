# Copy to .env (which is git-ignored) and adjust. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./app.db
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30

# Browser origins allowed to call the API (comma-separated, no "*"). Unset in development:
# the Vite dev server (http://localhost:5173 and http://127.0.0.1:5173). Unset elsewhere: none.
# CORS_ORIGINS=https://app.example.com

# Request size limits
MAX_UPLOAD_MB=100
MAX_REQUEST_BODY_KB=256

# Rate limits: COUNT/PERIOD with PERIOD = second, minute, hour or day. In memory, per process.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REGISTER=5/hour            # per client IP
# RATE_LIMIT_LOGIN=10/minute            # per client IP
# RATE_LIMIT_UPLOAD=20/hour             # per user
# RATE_LIMIT_FEEDBACK=10/hour           # per user (each call spends Gemini free-tier quota)
# RATE_LIMIT_FEEDBACK_GLOBAL=200/day    # shared by all users; empty = off
# RATE_LIMIT_DELETE_ACCOUNT=5/hour      # per user

# Quotas and analysis capacity
# MAX_TRACKS_PER_USER=200
# MAX_ANALYSES_PER_TRACK=50
# MAX_ACTIVE_ANALYSES_PER_USER=2        # pending + running
# MAX_ACTIVE_ANALYSES_GLOBAL=10         # pending + running, all users; beyond this: 503
# MAX_CONCURRENT_ANALYSES=2             # running at once (ffmpeg + essentia are CPU heavy)

# AI feedback (Gemini free tier). Without a key, POST /analyses/{id}/feedback answers 503.
FEEDBACK_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Reserved for a possible Anthropic provider later; currently unused.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
